 #ifndef KSYCOCAUTILS_P_H
 #define KSYCOCAUTILS_P_H
 
+#include <QDateTime>
 #include <QDir>
+#include <QFile>
 #include <QFileInfo>
 #include <QString>
+#include <QStringList>
+
+#include <qplatformdefs.h>
 
 namespace KSycocaUtilsPrivate
 {
+// When the last modification of what @p path names happened, in msecs since the epoch: the newest of the final
+// target and of every symlink traversed while resolving it. Retargeting a symlink changes what the path names
+// without touching the target's mtime, and on immutable package stores (NixOS, ostree) the target's mtime is
+// pinned, so the links are the only thing that ever moves.
+inline qint64 lastModifiedMSecs(const QString &path)
+{
+    const QDateTime targetTime = QFileInfo(path).lastModified();
+    qint64 stamp = targetTime.isValid() ? targetTime.toMSecsSinceEpoch() : 0;
+#ifdef Q_OS_UNIX
+    QStringList pending = QDir::cleanPath(path).split(QLatin1Char('/'), Qt::SkipEmptyParts);
+    QString resolved; // absolute, no trailing slash; empty is the root
+    int linksLeft = 40; // same bound as the kernel's ELOOP
+    while (!pending.isEmpty()) {
+        const QString component = pending.takeFirst();
+        if (component == QLatin1String(".")) {
+            continue;
+        }
+        if (component == QLatin1String("..")) {
+            resolved.truncate(qMax(0, resolved.lastIndexOf(QLatin1Char('/'))));
+            continue;
+        }
+        const QString candidate = resolved + QLatin1Char('/') + component;
+        QT_STATBUF st;
+        if (QT_LSTAT(QFile::encodeName(candidate).constData(), &st) != 0) {
+            break;
+        }
+        if (!S_ISLNK(st.st_mode)) {
+            resolved = candidate;
+            continue;
+        }
+        if (--linksLeft < 0) {
+            break;
+        }
+#if defined(Q_OS_MACOS) || defined(Q_OS_IOS)
+        const auto &mtim = st.st_mtimespec;
+#else
+        const auto &mtim = st.st_mtim;
+#endif
+        stamp = qMax(stamp, qint64(mtim.tv_sec) * 1000 + mtim.tv_nsec / 1000000);
+        const QString target = QFile::symLinkTarget(candidate); // absolute, whatever the link says
+        if (target.isEmpty()) {
+            break;
+        }
+        pending = target.split(QLatin1Char('/'), Qt::SkipEmptyParts) + pending;
+        resolved.clear();
+    }
+#endif
+    return stamp;
+}
