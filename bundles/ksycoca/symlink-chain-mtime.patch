+void KSycocaTest::retargetedSymlinkShouldRebuildSycocaOnce()
+{
+#ifndef Q_OS_UNIX
+    QSKIP("This test requires symlinks and utime");
+#else
+    // An applications dir reached through a symlink, the way immutable package stores publish them
+    // (NixOS: /run/current-system/sw/share/applications). Switching generations retargets the link;
+    // the directories themselves keep their old mtimes.
+    const QString gen1 = m_tempDir.path() + QLatin1String("/gen1/applications");
+    const QString gen2 = m_tempDir.path() + QLatin1String("/gen2/applications");
+    const QString link = m_tempDir.path() + QLatin1String("/applications");
+    QVERIFY(QDir().mkpath(gen1));
+    QVERIFY(QDir().mkpath(gen2));
+    const QString gen2App = gen2 + QLatin1String("/org.kde.gen2app.desktop");
+    {
+        KDesktopFile app(gen2App);
+        app.desktopGroup().writeEntry("Type", "Application");
+        app.desktopGroup().writeEntry("Exec", "gen2App");
+        app.desktopGroup().writeEntry("Name", "Gen2 App");
+    }
+    struct timeval tp;
+    gettimeofday(&tp, nullptr);
+    struct utimbuf utbuf;
+    utbuf.actime = tp.tv_sec;
+    utbuf.modtime = tp.tv_sec - 3600;
+    for (const QString &path : {gen1, gen2, gen2App}) {
+        QCOMPARE(utime(QFile::encodeName(path).constData(), &utbuf), 0);
+    }
+    QVERIFY(QFile::link(QStringLiteral("gen1/applications"), link));
+
+    ksycoca_ms_between_checks = 0;
+    QFile::remove(KSycoca::absoluteFilePath()); // the existing db predates the link and would not list it
+    QVERIFY(!KService::serviceByDesktopName(QStringLiteral("org.kde.gen2app")));
+    const QDateTime oldTimestamp = QFileInfo(KSycoca::absoluteFilePath()).lastModified();
+    QVERIFY(oldTimestamp.isValid());
+    QTest::qWait(s_waitDelay);
+
+    QVERIFY(QFile::remove(link));
+    QVERIFY(QFile::link(QStringLiteral("gen2/applications"), link));
+    QVERIFY(QFileInfo(link).lastModified() < oldTimestamp); // the target is old; only the link is new
+
+    QVERIFY(KService::serviceByDesktopName(QStringLiteral("org.kde.gen2app")));
+    const QDateTime newTimestamp = QFileInfo(KSycoca::absoluteFilePath()).lastModified();
+    QVERIFY(newTimestamp > oldTimestamp);
+
+    QTest::qWait(s_waitDelay);
+    KSycoca::self()->ensureCacheValid();
+    QCOMPARE(QFileInfo(KSycoca::absoluteFilePath()).lastModified(), newTimestamp); // same mtime, it didn't get rebuilt
+
+    // Ensure we don't pollute the other tests
+    QVERIFY(QFile::remove(link));
+    QDir(m_tempDir.path() + QLatin1String("/gen1")).removeRecursively();
+    QDir(m_tempDir.path() + QLatin1String("/gen2")).removeRecursively();
+    QFile::remove(KSycoca::absoluteFilePath());
+#endif
+}
