{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36525000,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_GB_DISK_CACHE_WHEN_TELEMETRY_OFF": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "10000",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5",
    "CLAUDE_CODE_NO_MODEL_FALLBACK": "1",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "15"
  },
  "attribution": {
    "sessionUrl": false,
    "commit": "\"{Assisted,Generated}-by: <model-id>[:effort] [harness[:version]]\" (see project policy for more info about nested agents)",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(//nix/store)",
      "Agent(Explore)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(col:*)",
      "Bash(git log:*)",
      "Bash(git grep:*)",
      "Bash(git cat-file:*)",
      "Bash(git check-ignore:*)",
      "Bash(git count-objects:*)",
      "Bash(git diff-index:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git merge-base:*)",
      "Bash(git read-tree:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show-ref:*)",
      "Bash(git verify-pack:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh search:*)",
      "Bash(command -v:*)",
      "Bash(echo \"exit:$?\")",
      "Bash(/home/ironmoon/workspace/claude/tools/cc-peer.py *)"
    ],
    "deny": [
      "Skill(artifact-capabilities)",
      "Artifact(*)",
      "ShareOnboardingGuide(*)",
      "mcp__claude_ai_*",
      "RemoteTrigger",
      "DesignSync"
    ],
    "defaultMode": "default"
  },
  "disableClaudeAiConnectors": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Messaging another Claude Code session, on this host or another host over ssh, through its peer messaging socket (e.g. /home/ironmoon/workspace/claude/tools/cc-peer.py, or socat to /run/user/*/cc-socks/*.sock), including reading that session's peerToken from ~/.claude/sessions/<pid>.*.key on the target host to authenticate. Only for sending messages to other sessions, not injecting input into the current session."
    ],
    "soft_deny": [
      "$defaults",
      "outward facing prose under my identity which has not been approved by declaudish agent",
      "including an PII (ex email) in user agents etc",
      "circumventing /goal timelines (especially using sleep commands)"
    ],
    "hard_deny": [
      "$defaults",
      "nix privilege escalation--current user is trusted",
      "docker privilege escalation--user is member of wheel"
    ],
    "environment": [
      "$defaults"
    ],
    "classifyAllShell": false
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "enableArtifact": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/guard-idle.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/guard-secrets.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-facts.sh\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/guard-bash.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-facts.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-time.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-host.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-facts.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-facts.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-time.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-host.sh\""
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-facts.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-time.sh\""
          }
        ]
      }
    ]
  },
  "workflowSizeGuideline": "unrestricted",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "coq-lsp@local-coq-lsp": true,
    "typst-lsp@local-typst-lsp": true
  },
  "extraKnownMarketplaces": {
    "local-coq-lsp": {
      "source": {
        "source": "directory",
        "path": "/home/ironmoon/.claude/my-marketplaces/coq-lsp"
      }
    },
    "local-typst-lsp": {
      "source": {
        "source": "directory",
        "path": "/home/ironmoon/.claude/my-marketplaces/typst-lsp"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Racketeering"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-mythos-5-1": {
      "effortLevel": "low"
    }
  },
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "feedbackDrafts": "off"
}
