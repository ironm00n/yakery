(defwidget bar []
  (centerbox :orientation "h"
    (workspaces)
    (time)
    (left)))

(deflisten workspace "hyprland-workspaces `hyprctl monitors -j | jq -r \".[0].name\"`")

(defwidget workspaces []
  (eventbox :onscroll "hyprctl dispatch workspace `echo {} | sed 's/up/+/\' | sed 's/down/-/'`1"
            :halign "start"
    (box :class "workspaces"
         :space-evenly false
      (for i in workspace
        (button
          :onclick "hyprctl dispatch workspace ${i.id}"
          :class "${i.class}"
          "${i.name}")))))

(defwidget time []
  (tooltip (calendar) "${EWW_TIME}"))

(defwidget left []
  (box :halign "end"
    (systray :space-evenly false)))


; FIXME: paramterize over monitor, how to deal with deflisten?
(defwindow bar
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "0%"
                               :width "100%"
                               :height "30px"
                               :anchor "top center")
           :stacking "fg"
           :exclusive true
           :windowtype "dock"
           :focusable "ondemand"
  (bar))
