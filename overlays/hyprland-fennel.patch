+// compiles every hyprland.fnl and .fnl module; macro modules are fennel's own business.
+// runs before `require` is wrapped, so `require!` is the raw, error-propagating one.
+static constexpr std::string_view FENNEL_PRELUDE = R"lua(
+local configDir, fennelDir = ...
+package.path = fennelDir .. "/?.lua;" .. package.path
+
+local fennel = require("fennel")
+local dir = configDir .. "/?"
+fennel.path = dir .. ".fnl;" .. dir .. "/init.fnl"
+fennel["macro-path"] = table.concat({ dir .. ".fnlm", dir .. "/init.fnlm", dir .. ".fnl", dir .. "/init-macros.fnl", dir .. "/init.fnl" }, ";")
+fennel.install({ correlate = true })
+
+_G[fennel.mangle("require!")] = require
+
+local function globals()
+    local names = {}
+    for k in pairs(_G) do
+        names[#names + 1] = fennel.unmangle(k)
+    end
+    return names
+end
+
+return function(path)
+    for k in pairs(fennel["macro-loaded"]) do
+        fennel["macro-loaded"][k] = nil
+    end
+
+    local f = assert(io.open(path))
+    local src = f:read("a")
+    f:close()
+
+    local lua = fennel.compileString(src, { filename = path, correlate = true, allowedGlobals = globals() })
+    return assert(load(lua, "@" .. path))
+end
+)lua";
+
+// survives the per-reload purge of package.loaded: the standard library, and the fennel
+// compiler, whose instance the installed searcher keeps using
+static bool isRuntimeModule(std::string_view mod) {
+    static constexpr std::string_view STDLIB[] = {"_G", "coroutine", "debug", "io", "math", "os", "package", "string", "table", "utf8", "bit32", "jit"};
+    return std::ranges::contains(STDLIB, mod) || mod == "fennel" || mod.starts_with("fennel.");
+}
+
+// same contract as luaL_loadfile: the chunk or the error message is left on the stack
+static int loadConfigFile(lua_State* L, const std::string& path) {
+    if (!path.ends_with(".fnl"))
+        return luaL_loadfile(L, path.c_str());
+
+    lua_getfield(L, LUA_REGISTRYINDEX, "hl_fennel_load");
+    lua_pushstring(L, path.c_str());
+    return lua_pcall(L, 1, 1, 0) == LUA_OK ? LUA_OK : LUA_ERRSYNTAX;
+}
+
+// every searcher answers (loader, filename) once it finds a module; the file is watched from
+// then on, so a module that fails to compile still reloads once it is fixed
+static int trackingSearcher(lua_State* L) {
+    auto* self = sc<CConfigManager*>(lua_touserdata(L, lua_upvalueindex(2)));
+    lua_pushvalue(L, lua_upvalueindex(1));
+    lua_insert(L, 1);
+    lua_call(L, lua_gettop(L) - 1, 2);
+    if (lua_isfunction(L, -2) && lua_isstring(L, -1))
+        trackConfigPath(self, lua_tostring(L, -1));
+    return 2;
+}
+
+static void wrapSearchers(lua_State* L, CConfigManager* self, int tableIdx, lua_Integer from) {
+    tableIdx = lua_absindex(L, tableIdx);
+    for (lua_Integer i = from; i <= sc<lua_Integer>(lua_rawlen(L, tableIdx)); ++i) {
+        lua_rawgeti(L, tableIdx, i);
+        lua_pushlightuserdata(L, self);
+        lua_pushcclosure(L, trackingSearcher, 2);
+        lua_rawseti(L, tableIdx, i);
+    }
+}
