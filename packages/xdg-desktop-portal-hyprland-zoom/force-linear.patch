@@ -1112,11 +1112,34 @@ uint32_t CPipewireConnection::buildFormatsFor(spa_pod_builder* b[2], const spa_p
     uint32_t            modCount   = 0;
     uint64_t*           modifiers  = nullptr;
 
-    static auto* const* PFORCESHM = (Hyprlang::INT* const*)g_pPortalManager->m_sConfig.config->getConfigValuePtr("screencopy:force_shm")->getDataStaticPtr();
-    const bool          forceSHM  = **PFORCESHM || stream->dmaBufFailed;
+    static auto* const* PFORCESHM        = (Hyprlang::INT* const*)g_pPortalManager->m_sConfig.config->getConfigValuePtr("screencopy:force_shm")->getDataStaticPtr();
+    static auto* const* PFORCELINEAR     = (Hyprlang::INT* const*)g_pPortalManager->m_sConfig.config->getConfigValuePtr("screencopy:force_linear")->getDataStaticPtr();
+    static auto* const* PFORCELINEARAPPS = (Hyprlang::STRING* const)g_pPortalManager->m_sConfig.config->getConfigValuePtr("screencopy:force_linear_apps")->getDataStaticPtr();
+
+    bool                appForceLinear = false;
+    const char*         forceApps      = *PFORCELINEARAPPS;
+    if (!stream->pSession->appid.empty() && forceApps && *forceApps) {
+        std::string haystack = std::string(",") + forceApps + ",";
+        std::erase(haystack, ' ');
+        appForceLinear = haystack.find("," + stream->pSession->appid + ",") != std::string::npos;
+    }
+
+    const bool          forceSHM     = **PFORCESHM || stream->dmaBufFailed;
+    const bool          forceLinear  = **PFORCELINEAR || appForceLinear;
+
+    bool                haveDMA      = false;
+    if (!forceSHM) {
+        if (forceLinear) {
+            modifiers    = (uint64_t*)calloc(1, sizeof(uint64_t));
+            modifiers[0] = DRM_FORMAT_MOD_LINEAR;
+            modCount     = 1;
+            haveDMA      = true;
+        } else
+            haveDMA = build_modifierlist(stream, stream->pSession->sharingData.frameInfoDMA.fmt, &modifiers, &modCount) && modCount > 0;
+    }
 
-    if (!forceSHM && build_modifierlist(stream, stream->pSession->sharingData.frameInfoDMA.fmt, &modifiers, &modCount) && modCount > 0) {
-        Debug::log(LOG, "[pw] Building modifiers for dma");
+    if (haveDMA) {
+        Debug::log(LOG, forceLinear ? "[pw] Building modifiers for dma (linear only)" : "[pw] Building modifiers for dma");
 
         paramCount = 2;
         params[0]  = build_format(b[0], pwFromDrmFourcc(stream->pSession->sharingData.frameInfoDMA.fmt), stream->pSession->sharingData.frameInfoDMA.w,
