# xdg-desktop-portal-hyprland: per-app linear DMA-BUF for screencast.
#
# Some PipeWire consumers (notably Zoom under XWayland) advertise dmabuf-modifier
# support but cannot import a tiled buffer, so they render the screenshare black;
# linear dmabuf and SHM import fine. This adds two screencopy config options:
# - `force_linear`: offer only the LINEAR modifier to every consumer
# - `force_linear_apps`: comma-separated portal app_ids forced to linear
# The app_id is known at stream setup, so linear is offered from the first frame
# (no renegotiation); consumers that don't match keep tiled zero-copy dmabuf.
diff --git a/src/core/PortalManager.cpp b/src/core/PortalManager.cpp
index cf733a3..7944a5f 100644
--- a/src/core/PortalManager.cpp
+++ b/src/core/PortalManager.cpp
@@ -45,6 +45,8 @@ CPortalManager::CPortalManager() {
     m_sConfig.config->addConfigValue("screencopy:allow_token_by_default", Hyprlang::INT{0L});
     m_sConfig.config->addConfigValue("screencopy:custom_picker_binary", Hyprlang::STRING{""});
     m_sConfig.config->addConfigValue("screencopy:force_shm", Hyprlang::INT{0L});
+    m_sConfig.config->addConfigValue("screencopy:force_linear", Hyprlang::INT{0L});
+    m_sConfig.config->addConfigValue("screencopy:force_linear_apps", Hyprlang::STRING{""});
 
     m_sConfig.config->commence();
     m_sConfig.config->parse();
diff --git a/src/portals/Screencopy.cpp b/src/portals/Screencopy.cpp
