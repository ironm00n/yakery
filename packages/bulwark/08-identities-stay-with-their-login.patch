@@ -0,0 +1,150 @@
+import { beforeAll, expect, it, vi } from 'vitest';
+import { createConfig } from '@/lib/__tests__/fixtures/config';
+
+// The identity stores hold the active login's identities: the composer offers
+// them as that login's own and sends from them. Identities that arrived for
+// one login while another was active - or were written before the previous
+// login's snapshot was taken - put one login's addresses into another, or
+// left a login with none.
+const IDS: Record<string, Array<{ id: string; email: string; name: string; mayDelete: boolean }>> = {
+  'a@x.test': [{ id: 'a', email: 'a@x.test', name: 'Alice', mayDelete: false }],
+  'b@y.test': [{ id: 'a', email: 'b@y.test', name: 'Bob', mayDelete: false }],
+  'c@z.test': [{ id: 'a', email: 'c@z.test', name: 'Carol', mayDelete: false }],
+  'o@w.test': [{ id: 'a', email: 'o@w.test', name: 'Olga', mayDelete: false }],
+};
+// A login named here has its Identity/get held until released, after letting
+// the given number of calls through.
+const held = vi.hoisted(() => ({ after: new Map<string, number>(), release: new Map<string, () => void>() }));
+
+vi.mock('@/lib/jmap/client', () => {
+  class JMAPClient {
+    sessionName = '';
+    constructor(public serverUrl: string, public username: string, public password: string) {}
+    // An OAuth client is built without a username; the session names it.
+    static withBearer(serverUrl: string) {
+      const client = new JMAPClient(serverUrl, '', '');
+      client.sessionName = 'o@w.test';
+      return client;
+    }
+    async connect() {}
+    getSessionUsername() { return this.getUsername(); }
+    getUsername() { return this.username || this.sessionName; }
+    async getIdentities() {
+      const name = this.getUsername();
+      const after = held.after.get(name);
+      if (after !== undefined) {
+        if (after > 0) held.after.set(name, after - 1);
+        else {
+          held.after.delete(name);
+          await new Promise<void>((r) => { held.release.set(name, r); });
+        }
+      }
+      return IDS[name];
+    }
+    getAuthHeader() { return 'Basic eA=='; }
+    onConnectionChange() {}
+    onRateLimit() {}
+    getRateLimitRemainingMs() { return 0; }
+    supportsContacts() { return false; }
+    supportsPrincipals() { return false; }
+    supportsVacationResponse() { return false; }
+    supportsCalendars() { return false; }
+    supportsSieve() { return false; }
+    disconnect() {}
+    getAccountId() { return 'acct'; }
+  }
+  class RateLimitError extends Error {}
+  return { JMAPClient, RateLimitError };
+});
+vi.mock('@/lib/stalwart/principal', () => ({ fetchPrincipalDisplayName: async () => null }));
+
+import { useAuthStore } from '@/stores/auth-store';
+import { useAccountStore } from '@/stores/account-store';
+import { useIdentityStore } from '@/stores/identity-store';
+import { evictAccount } from '@/lib/account-state-manager';
+
+const acct = (username: string, host: string, slot: number) => ({
+  id: `${username}@${host}`, label: username, serverUrl: `https://${host}`, username, authMode: 'basic' as const,
+  rememberMe: true, cookieSlot: slot, displayName: username, email: username, isConnected: false, hasError: false,
+  lastLoginAt: 1, avatarColor: '#000', isDefault: slot === 0,
+});
+const A = acct('a@x.test', 'mail.x.test', 0);
+const B = acct('b@y.test', 'mail.y.test', 1);
+const C = acct('c@z.test', 'mail.z.test', 2);
+
+beforeAll(() => {
+  vi.stubGlobal('fetch', vi.fn(async (input: unknown) => {
+    const url = String(input);
+    const m = url.match(/\/api\/auth\/session\?slot=(\d)/);
+    if (m) {
+      const a = [A, B, C][Number(m[1])];
+      return new Response(JSON.stringify({ serverUrl: a.serverUrl, username: a.username, password: 'pw' }), { status: 200 });
+    }
+    if (url.includes('/api/auth/token')) return new Response(JSON.stringify({ access_token: 't', expires_in: 3600 }), { status: 200 });
+    if (url.includes('/api/config')) return new Response(JSON.stringify(createConfig()), { status: 200 });
+    return new Response('{}', { status: 200 });
+  }));
+});
+
+const shown = () => ({
+  auth: useAuthStore.getState().identities.map((i) => i.email),
+  identityStore: useIdentityStore.getState().identities.map((i) => i.email),
+});
+const showing = (email: string) => ({ auth: [email], identityStore: [email] });
+const release = async (username: string) => {
+  await vi.waitFor(() => expect(held.release.has(username)).toBe(true));
+  held.release.get(username)!();
+  held.release.delete(username);
+  await new Promise((r) => setTimeout(r, 0));
+};
+const sw = (id: string) => useAuthStore.getState().switchAccount(id);
+
+it("identities restored for A that arrive after a switch to B stay A's", async () => {
+  useAccountStore.setState({ accounts: [A, B] as never, activeAccountId: A.id, defaultAccountId: A.id });
+  held.after.set(A.username, 0);
+  await useAuthStore.getState().checkAuth();
+  expect(useAuthStore.getState().activeAccountId).toBe(A.id);
+  await vi.waitFor(() => expect(useAuthStore.getState().restoringAccounts).toBe(false));
+
+  await sw(B.id);
+  expect(shown()).toEqual(showing('b@y.test'));
+
+  await release(A.username);
+  expect(useAuthStore.getState().activeAccountId).toBe(B.id);
+  expect(shown()).toEqual(showing('b@y.test'));
+
+  await sw(A.id);
+  expect(shown()).toEqual(showing('a@x.test'));
+});
+
+it('a switch overtaken by another keeps its late identities out of the stores', async () => {
+  useAccountStore.setState({ accounts: [A, B, C] as never });
+  await sw(C.id);
+  await sw(A.id);
+  evictAccount(B.id);
+
+  // The first is the switch's session check, the second its identities.
+  held.after.set(B.username, 1);
+  const toB = sw(B.id);
+  await vi.waitFor(() => expect(held.release.has(B.username)).toBe(true));
+  await sw(C.id);
+  expect(shown()).toEqual(showing('c@z.test'));
+
+  await release(B.username);
+  await toB;
+  expect(useAuthStore.getState().activeAccountId).toBe(C.id);
+  expect(shown()).toEqual(showing('c@z.test'));
+});
+
+it("an OAuth sign-in leaves the previous login's identities with it", async () => {
+  await sw(B.id);
+  expect(shown()).toEqual(showing('b@y.test'));
+
+  const signedIn = await useAuthStore.getState().loginWithOAuth('https://mail.w.test', 'code', 'verifier', 'https://app/callback');
+  expect(signedIn).toBe(true);
+  expect(useAuthStore.getState().username).toBe('o@w.test');
+  expect(shown()).toEqual(showing('o@w.test'));
+
+  await sw(B.id);
+  expect(shown()).toEqual(showing('b@y.test'));
+});
