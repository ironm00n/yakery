diff --git a/lib/__tests__/email-frame-quotes.test.ts b/lib/__tests__/email-frame-quotes.test.ts
new file mode 100644
index 00000000..1fb8db23
--- /dev/null
+++ b/lib/__tests__/email-frame-quotes.test.ts
@@ -0,0 +1,34 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import { sanitizeEmailBodyForIframe } from '@/lib/email-sanitization';
+import { BARE_QUOTE_CSS } from '@/lib/email-frame-quotes';
+
+function frameQuotes(html: string): HTMLElement[] {
+  const sheet = document.createElement('style');
+  sheet.textContent = BARE_QUOTE_CSS;
+  const body = document.createElement('div');
+  body.innerHTML = sanitizeEmailBodyForIframe(html, true).html;
+  document.head.append(sheet);
+  document.body.append(body);
+  return [...body.querySelectorAll('blockquote')] as HTMLElement[];
+}
+const bar = (quote: Element) => getComputedStyle(quote).getPropertyValue('border-inline-start');
+
+afterEach(() => {
+  document.head.innerHTML = '';
+  document.body.innerHTML = '';
+});
+
+describe('quotes in a mail frame', () => {
+  it('keep the bar on a bare quote after the quote collapse and the dark pass write inline styles', () => {
+    const [quote] = frameQuotes('<p>On Friday, Carol wrote:</p><blockquote type="cite">a bare quote</blockquote>');
+    quote.style.display = 'none';
+    quote.style.display = '';
+    quote.style.setProperty('border-left-color', 'rgb(44, 44, 44)', 'important');
+    expect(bar(quote)).toBe('2px solid #c5c5c5');
+  });
+
+  it("go by the sender's style, not by a marker the sender wrote", () => {
+    const quotes = frameQuotes('<blockquote style="margin:0" class="bulwark-bare-quote">styled</blockquote><blockquote>bare</blockquote>');
+    expect(quotes.map(bar)).toEqual(['', '2px solid #c5c5c5']);
+  });
+});
diff --git a/lib/email-frame-quotes.ts b/lib/email-frame-quotes.ts
new file mode 100644
index 00000000..81cb7297
--- /dev/null
+++ b/lib/email-frame-quotes.ts
@@ -0,0 +1,18 @@
+/**
+ * Quotes in a mail frame. Bulwark's own reply quote carries an inline style
+ * (a bar and an indent), so a bare `<blockquote>` (Thunderbird's
+ * `type="cite"`, a Markdown mail's `>`) gets the same bar here. A quote that
+ * styles itself, like Gmail's or Outlook's, keeps its own look. The bar is on
+ * the inline start, so a right-to-left mail has it on the right.
+ *
+ * Whether a quote came with a style is read while sanitizing, because the
+ * frame's dark pass and quote collapse write inline styles of their own later.
+ */
+const BARE_QUOTE_CLASS = 'bulwark-bare-quote';
+
+export function markBareQuoteOnNode(node: Element): void {
+  if (node.localName === 'blockquote') node.classList.toggle(BARE_QUOTE_CLASS, !node.hasAttribute('style'));
+}
+
+export const BARE_QUOTE_CSS =
+  `blockquote.${BARE_QUOTE_CLASS} { margin-block: 8px; margin-inline: 0; padding-inline-start: 12px; border-inline-start: 2px solid #c5c5c5; }`;
