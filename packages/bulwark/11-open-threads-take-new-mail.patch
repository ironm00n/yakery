diff --git a/lib/conversation.ts b/lib/conversation.ts
new file mode 100644
index 00000000..cfa0504b
--- /dev/null
+++ b/lib/conversation.ts
@@ -0,0 +1,40 @@
+import type { IJMAPClient } from "@/lib/jmap/client-interface";
+import type { Email } from "@/lib/jmap/types";
+
+const oldestFirst = (a: Email, b: Email) => a.receivedAt.localeCompare(b.receivedAt);
+
+// Stamped with ref's source, so opening one in a merged view reaches the right account.
+function asConversation(thread: Email[], ref: Email): Email[] {
+  const { accountId, accountLabel, sourceClientAccountId, sourceAccountId } = ref;
+  return thread
+    .filter((e) => e.id === ref.id || !e.keywords?.$draft)
+    .map((e) => ({ ...e, accountId, accountLabel, sourceClientAccountId, sourceAccountId }))
+    .sort(oldestFirst);
+}
+
+/** The conversation around `ref` (list properties only), or null for a thread of one. */
+export async function readConversation(client: IJMAPClient, ref: Email, accountId?: string): Promise<Email[] | null> {
+  const ids = (await client.getThread(ref.threadId, accountId))?.emailIds ?? [];
+  return ids.length < 2 ? null : asConversation(await client.getSomeEmails(ids, accountId), ref);
+}
+
+/**
+ * `held` after a change reporting `fresh` mail as it now is: mail new to the
+ * thread joins, mail `gone` or out of it leaves, and the rest keeps what is
+ * held (a loaded body) under its new keywords and folders, all an Email can
+ * change (RFC 8621 §4.1.1). `ref` stays; `held` itself when nothing changed.
+ */
+export function conversationAfter(held: Email[], ref: Email, fresh: Email[], gone: (id: string) => boolean): Email[] {
+  const freshById = new Map(fresh.map((e) => [e.id, e]));
+  const kept = held.flatMap((e): Email[] => {
+    const now = freshById.get(e.id);
+    if (!now) return e.id !== ref.id && gone(e.id) ? [] : [e];
+    if (now.threadId !== ref.threadId) return [];
+    const same = JSON.stringify([e.keywords, e.mailboxIds]) === JSON.stringify([now.keywords, now.mailboxIds]);
+    return [same ? e : { ...e, keywords: now.keywords, mailboxIds: now.mailboxIds }];
+  });
+  const heldIds = new Set(held.map((e) => e.id));
+  const joined = asConversation(fresh.filter((e) => e.threadId === ref.threadId && !heldIds.has(e.id)), ref);
+  const unchanged = joined.length === 0 && kept.length === held.length && kept.every((e, i) => e === held[i]);
+  return unchanged ? held : [...kept, ...joined].sort(oldestFirst);
+}
