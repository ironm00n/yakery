diff --git a/lib/__tests__/jmap-send-sender-address.test.ts b/lib/__tests__/jmap-send-sender-address.test.ts
new file mode 100644
index 00000000..5071a87b
--- /dev/null
+++ b/lib/__tests__/jmap-send-sender-address.test.ts
@@ -0,0 +1,142 @@
+import { describe, it, expect, vi, afterEach } from 'vitest';
+import { JMAPClient } from '../jmap/client';
+import { buildMdnMessage } from '../mdn';
+import { SenderAddressError } from '../sender-address';
+
+// A send with no From fell back to the login name - '' for an OAuth login,
+// "ironmoon" for a short one - and went out with a From no client could
+// parse and a Message-ID `@localhost`; with one it fell back to the
+// account's first identity. Such a send is refused, never given an invented
+// address or a sender the caller did not name.
+
+type MethodCall = [string, Record<string, unknown>, string];
+type Identity = { id: string; email: string; mayDelete: boolean };
+
+function createClient(username: string): JMAPClient {
+  const client = new JMAPClient('https://jmap.example.com', username, 'pass');
+  Object.assign(client, { apiUrl: 'https://jmap.example.com/api', accountId: 'account-1', username });
+  return client;
+}
+
+/** Answers sendEmail's requests; returns every method the client called. */
+function mockServer(identities: Identity[]) {
+  const calls: MethodCall[] = [];
+  vi.spyOn(globalThis, 'fetch').mockImplementation(async (_url, init) => {
+    const { methodCalls } = JSON.parse((init as { body: string }).body) as { methodCalls: MethodCall[] };
+    calls.push(...methodCalls);
+    const methodResponses = methodCalls.map(([name, args, callId]) => {
+      if (name === 'Mailbox/get') {
+        return [name, { list: [{ id: 'mb-drafts', name: 'Drafts', role: 'drafts' }, { id: 'mb-sent', name: 'Sent', role: 'sent' }] }, callId];
+      }
+      if (name === 'Identity/get') return [name, { list: identities }, callId];
+      if (name === 'Email/set') {
+        const created = Object.keys((args.create ?? {}) as object);
+        return [name, { created: Object.fromEntries(created.map((id) => [id, { id: 'email-9' }])) }, callId];
+      }
+      if (name === 'EmailSubmission/set') return [name, { created: { '1': { id: 'sub-1' } } }, callId];
+      return ['error', { type: 'unknownMethod' }, callId];
+    });
+    const payload = { methodResponses };
+    return { ok: true, status: 200, text: () => Promise.resolve(JSON.stringify(payload)), json: () => Promise.resolve(payload) } as Response;
+  });
+  return calls;
+}
+
+const send = (client: JMAPClient, fromEmail?: string, identityId?: string) =>
+  client.sendEmail(['bob@example.net'], 'Hi', 'Body', undefined, undefined, identityId, fromEmail);
+
+const createdEmail = (calls: MethodCall[]) => {
+  const set = calls.find(([name]) => name === 'Email/set');
+  return set ? Object.values(set[1].create as Record<string, Record<string, unknown>>)[0] : undefined;
+};
+const submittedIdentityId = (calls: MethodCall[]) => {
+  const set = calls.find(([name]) => name === 'EmailSubmission/set');
+  return set ? Object.values(set[1].create as Record<string, { identityId: string }>)[0].identityId : undefined;
+};
+const wroteAnything = (calls: MethodCall[]) =>
+  calls.some(([name]) => name === 'Email/set' || name === 'EmailSubmission/set');
+
+afterEach(() => vi.restoreAllMocks());
+
+describe('sendEmail refuses a sender that is not an address', () => {
+  it.each(['', 'ironmoon'])('with no From and an account without identities (login %j)', async (login) => {
+    const calls = mockServer([]);
+    await expect(send(createClient(login))).rejects.toBeInstanceOf(SenderAddressError);
+    expect(wroteAnything(calls)).toBe(false);
+  });
+
+  it('with a From that has no @', async () => {
+    const calls = mockServer([{ id: 'i1', email: 'me@example.com', mayDelete: false }]);
+    await expect(send(createClient(''), 'me', 'i1')).rejects.toThrow('Not sent: the sender "me" is not an email address');
+    expect(wroteAnything(calls)).toBe(false);
+  });
+
+  it('with an address but no identity to send it through', async () => {
+    const calls = mockServer([]);
+    await expect(send(createClient(''), 'me@example.com')).rejects.toBeInstanceOf(SenderAddressError);
+    expect(wroteAnything(calls)).toBe(false);
+  });
+});
+
+describe('sendEmail sends only from the sender its caller names', () => {
+  const identities = [
+    { id: 'i1', email: 'first@example.com', mayDelete: false },
+    { id: 'i2', email: 'me@example.org', mayDelete: false },
+  ];
+
+  it('refuses with neither an identity nor a From, rather than send from the first identity', async () => {
+    const calls = mockServer(identities);
+    await expect(send(createClient('me@example.org'))).rejects.toBeInstanceOf(SenderAddressError);
+    expect(wroteAnything(calls)).toBe(false);
+  });
+
+  it('refuses a From that is none of the identities, with no identity named', async () => {
+    const calls = mockServer(identities);
+    await expect(send(createClient(''), 'other@example.org')).rejects.toBeInstanceOf(SenderAddressError);
+    expect(wroteAnything(calls)).toBe(false);
+  });
+
+  it('sends from the identity it is given, with a Message-ID at its domain', async () => {
+    const calls = mockServer(identities);
+    await send(createClient(''), undefined, 'i2');
+    const email = createdEmail(calls)!;
+    expect(email.from).toEqual([{ email: 'me@example.org' }]);
+    expect((email.messageId as string[])[0]).toMatch(/@example\.org$/);
+    expect(submittedIdentityId(calls)).toBe('i2');
+  });
+
+  it('sends as the From it is given, through the identity with that address', async () => {
+    const calls = mockServer(identities);
+    await send(createClient(''), 'me@example.org');
+    expect(createdEmail(calls)!.from).toEqual([{ email: 'me@example.org' }]);
+    expect(submittedIdentityId(calls)).toBe('i2');
+  });
+});
+
+describe('an invitation reply', () => {
+  const reply = (client: JMAPClient, attendeeEmail: string) => client.sendImipReply({
+    organizerEmail: 'organizer@example.net', attendeeEmail, uid: 'uid-1@example.net',
+    summary: 'Meet', dtStart: '2026-10-20T10:00:00', status: 'ACCEPTED',
+  });
+  const identities = [
