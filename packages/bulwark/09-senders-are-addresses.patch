diff --git a/lib/sender-address.ts b/lib/sender-address.ts
new file mode 100644
index 00000000..1dd9511b
--- /dev/null
+++ b/lib/sender-address.ts
@@ -0,0 +1,22 @@
+/**
+ * Raised instead of sending mail whose sender is not an address, or that names
+ * no sender at all. A login name (`''` for an OAuth login) used to stand in for
+ * a missing identity: the message left with a From no client could parse and
+ * a Message-ID `@localhost`. The account's first identity is no stand-in
+ * either: Bulwark never picks a sender the user did not.
+ */
+export class SenderAddressError extends Error {
+  constructor(sender?: string) {
+    super(sender
+      ? `Not sent: the sender "${sender}" is not an email address`
+      : 'Not sent: no sending identity was chosen');
+    this.name = 'SenderAddressError';
+  }
+}
+
+/** `sender` when it is an address with a local part and a domain; throws otherwise. */
+export function requireSenderAddress(sender: string | null | undefined): string {
+  const at = sender?.lastIndexOf('@') ?? -1;
+  if (!sender || at <= 0 || at === sender.length - 1) throw new SenderAddressError(sender ?? undefined);
+  return sender;
+}
