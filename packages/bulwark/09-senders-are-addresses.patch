+import { useAccountStore } from '@/stores/account-store';
+import { useEmailStore } from '@/stores/email-store';
+
+// A List-Unsubscribe mailto in a unified view went out through the login
+// holding the newsletter with no identity named, and sendEmail sent it from
+// that login's first identity. It goes from the identity the newsletter was
+// addressed to, and without one it does not go.
+
+vi.mock('@/hooks/use-media-query', () => ({
+  useDeviceDetection: () => ({ isMobile: false, isTablet: false, isDesktop: true }),
+  useMediaQuery: () => false,
+  useIsDesktop: () => true,
+}));
+vi.mock('@/components/tour/tour-provider', () => ({
+  useTour: () => ({ activeTour: null, startTour: vi.fn(), endTour: vi.fn(), registerStep: vi.fn() }),
+}));
+vi.mock('@/components/plugins/plugin-slot', () => ({ PluginSlot: () => null }));
+vi.mock('@/hooks/use-plugin-slot-offers', () => ({ usePluginSlotOffers: () => [] }));
+
+class NoopResizeObserver {
+  observe() {}
+  unobserve() {}
+  disconnect() {}
+}
+vi.stubGlobal('ResizeObserver', NoopResizeObserver);
+
+const { EmailViewer } = await import('../email-viewer');
+
+const mailboxes = [
+  { id: 'inbox', name: 'Inbox', role: 'inbox', parentId: null, myRights: { mayAddItems: true } },
+] as unknown as Mailbox[];
+
+const identity = (id: string, email: string) => ({ id, email, name: email }) as Identity;
+
+const loginClient = (accountId: string, identities: Identity[]) => ({
+  getAccountId: () => accountId, getSieveAccountId: () => null, hasDelayedSend: () => false, getSession: () => null,
+  getIdentities: vi.fn(async () => identities),
+  sendEmail: vi.fn(async () => ({})),
+});
+
+const newsletter = (to: string, stamp: Partial<Email> = {}) => ({
+  id: 'e1', blobId: 'b1', threadId: 't1', mailboxIds: { inbox: true }, keywords: { $seen: true },
+  from: [{ name: 'News', email: 'news@list.example' }], to: [{ name: '', email: to }],
+  subject: 'Issue 12', receivedAt: '2026-01-01T00:00:00Z', preview: 'News', hasAttachment: false, size: 100,
+  textBody: [{ partId: '1', type: 'text/plain' }], htmlBody: [{ partId: '1', type: 'text/plain' }], attachments: [],
+  bodyValues: { '1': { value: 'News' } },
+  headers: { 'List-Unsubscribe': '<mailto:leave@list.example?subject=unsubscribe>' },
+  ...stamp,
+}) as unknown as Email;
+
+const clientA = loginClient('jmap-a', [identity('a0', 'me@a.example')]);
+const clientB = loginClient('jmap-b', [identity('b0', 'first@b.example'), identity('b1', 'me@b.example')]);
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  useAccountStore.setState({
+    accounts: [{ id: 'A', isConnected: true }, { id: 'B', isConnected: true }] as never,
+  });
+  useAuthStore.setState({
+    client: clientA as never,
+    activeAccountId: 'A',
+    identities: [identity('a0', 'me@a.example')],
+    getClientForAccount: ((id: string) => ({ A: clientA, B: clientB } as never)[id]) as never,
+  });
+  useEmailStore.setState({ viewingAccountId: null });
+});
+
+const unsubscribe = async (email: Email) => {
+  render(<EmailViewer email={email} mailboxes={mailboxes} selectedMailbox="inbox" currentMailboxRole="inbox" />);
+  fireEvent.click((await screen.findAllByText('email_viewer.unsubscribe_banner.button'))[0]);
+  fireEvent.click(screen.getAllByText('email_viewer.unsubscribe_banner.confirm_button')[0]);
+};
+
+describe('List-Unsubscribe mailto for a newsletter another login holds', () => {
+  it('is sent through that login, from its identity the newsletter was addressed to', async () => {
+    await unsubscribe(newsletter('me@b.example', { sourceClientAccountId: 'B', sourceAccountId: 'jmap-b' }));
+
+    await waitFor(() => expect(clientB.sendEmail).toHaveBeenCalledTimes(1));
+    const [to, , , , , identityId, fromEmail] = clientB.sendEmail.mock.calls[0] as unknown[];
+    expect(to).toEqual(['leave@list.example']);
+    expect({ identityId, fromEmail }).toEqual({ identityId: 'b1', fromEmail: 'me@b.example' });
+    expect(clientA.sendEmail).not.toHaveBeenCalled();
+  });
+
+  it("is not sent when it reached none of that login's identities", async () => {
+    await unsubscribe(newsletter('me@a.example', { sourceClientAccountId: 'B', sourceAccountId: 'jmap-b' }));
+
+    await screen.findByText('email_viewer.unsubscribe_banner.error');
+    expect(clientB.sendEmail).not.toHaveBeenCalled();
+    expect(clientA.sendEmail).not.toHaveBeenCalled();
+  });
+});
