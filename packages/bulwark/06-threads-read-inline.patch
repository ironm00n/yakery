+import React from 'react';
+import { act, fireEvent, render, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Email, Mailbox } from '@/lib/jmap/types';
+import { useAuthStore } from '@/stores/auth-store';
+import { useEmailStore } from '@/stores/email-store';
+import { useSettingsStore } from '@/stores/settings-store';
+import { usePluginStore } from '@/stores/plugin-store';
+import { useThemeStore } from '@/stores/theme-store';
+import { DEFAULT_SEARCH_FILTERS } from '@/lib/jmap/search-utils';
+
+// The default interface's reading pane holds a thread of more than one
+// message as its conversation, and previous / next step over the list's rows.
+
+vi.mock('@/components/layout/sidebar', () => ({ Sidebar: () => null }));
+vi.mock('@/components/layout/navigation-rail', () => ({ NavigationRail: () => null }));
+vi.mock('@/components/layout/calendar-event-notification-toaster', () => ({ CalendarEventNotificationToaster: () => null }));
+vi.mock('@/components/layout/share-notification-toaster', () => ({ ShareNotificationToaster: () => null }));
+vi.mock('@/components/layout/mobile-header', () => ({ MobileHeader: () => null }));
+vi.mock('@/components/email/message-list-tabs', () => ({ MessageListTabs: () => null }));
+vi.mock('@/components/search/search-box', () => ({ SearchBox: () => null }));
+vi.mock('@/components/tour/tour-provider', () => ({ useTour: () => ({ activeTour: null, registerStep: vi.fn() }) }));
+vi.mock('@/components/plugins/plugin-slot', () => ({ PluginSlot: () => null }));
+vi.mock('@/hooks/use-plugin-slot-offers', () => ({ usePluginSlotOffers: () => [] }));
+vi.mock('@/hooks/use-config', () => ({ useConfig: () => ({ appName: 'Mail' }) }));
+vi.mock('@/hooks/use-identity-sync', () => ({ useIdentitySync: () => {} }));
+vi.mock('@/hooks/use-pro-multi-account-identities', () => ({ useProMultiAccountIdentities: () => [] }));
+vi.mock('@/hooks/use-pro-multi-account-mailboxes', () => ({ useProMultiAccountMailboxes: () => {} }));
+vi.mock('@/hooks/use-wopi-status', () => ({ useWopiStatus: () => null, canWopiOpen: () => false }));
+vi.mock('@/hooks/use-browser-navigation', () => ({ useBrowserNavigation: () => {} }));
+vi.mock('@/hooks/use-media-query', () => ({
+  useDeviceDetection: () => ({ isMobile: false, isTablet: false, isDesktop: true }),
+  useMediaQuery: () => false,
+  useIsDesktop: () => true,
+  useIsMobile: () => false,
+}));
+vi.mock('@/lib/push-bindings', () => ({ reconcilePushBindings: () => {}, releasePushBindings: () => {} }));
+vi.mock('@/components/email/email-list', () => ({ EmailList: () => null }));
+vi.mock('@/components/email/email-viewer', () => ({ EmailViewer: () => null }));
+
+const { MailApp } = await import('../mail-app');
+
+const inbox = { id: 'inbox', name: 'Inbox', role: 'inbox' } as Mailbox;
+const mail = (id: string, threadId: string, day: number): Email => ({
+  id, threadId, blobId: `blob-${id}`, subject: id, mailboxIds: { inbox: true }, keywords: { $seen: true },
+  size: 10, receivedAt: `2026-01-${String(day).padStart(2, '0')}T00:00:00Z`, from: [{ email: `${id}@example.com` }],
+  to: [], preview: '', hasAttachment: false,
+}) as Email;
+// Newest first, as the server lists them: thread `a` has a row of two.
+const a2 = mail('a2', 'a', 4);
+const b = mail('b', 'b', 3);
+const a1 = mail('a1', 'a', 2);
+const c = mail('c', 'c', 1);
+
+let client: Record<string, ReturnType<typeof vi.fn> | (() => unknown)>;
+beforeEach(() => {
+  vi.stubGlobal('fetch', vi.fn().mockRejectedValue(new Error('Unexpected network request')));
+  vi.stubGlobal('ResizeObserver', class { observe() {} unobserve() {} disconnect() {} });
+  usePluginStore.setState({ initializePlugins: vi.fn().mockResolvedValue(undefined) });
+  useThemeStore.setState({ syncServerThemes: vi.fn().mockResolvedValue(undefined) });
+  client = {
+    getAccountId: () => 'acc', getUsername: () => 'me@example.com',
+    getSieveAccountId: () => null, hasDelayedSend: () => false, getSession: () => null,
+    getEmail: vi.fn(async (id: string) => [a2, b, a1, c].find((e) => e.id === id) ?? null),
+    getThread: vi.fn(async (threadId: string) => ({ id: threadId, emailIds: [a1, a2].filter((e) => e.threadId === threadId).map((e) => e.id) })),
+    getSomeEmails: vi.fn(async (ids: string[]) => [a1, a2].filter((e) => ids.includes(e.id))),
+    markAsRead: vi.fn().mockResolvedValue(undefined),
+  };
+  useAuthStore.setState({
+    isAuthenticated: true, isLoading: false, client: client as never, activeAccountId: 'login', identities: [],
+    getClientForAccount: () => client as never,
+    getAllConnectedClients: () => new Map([['login', client]]) as never,
+  });
+  useSettingsStore.setState({ enableUnifiedMailbox: false, mailLayout: 'split', interfaceLayout: 'default', disableThreading: false, markAsReadDelay: -1 } as never);
+  useEmailStore.setState({
+    emails: [a2, b, a1, c], selectedEmail: a2, selectedMailbox: inbox.id, mailboxes: [inbox],
+    threadEmailCounts: new Map(), viewingAccountId: null, accountMailboxes: {}, isUnifiedView: false, unifiedRole: null,
+    isScheduledView: false, isLoadingEmail: false, isLoading: false, searchQuery: '',
+    searchFilters: { ...DEFAULT_SEARCH_FILTERS }, searchMailboxId: '', selectedKeyword: null,
+    selectedEmailKeys: new Set(),
+    fetchMailboxes: vi.fn().mockResolvedValue(undefined), fetchEmails: vi.fn().mockResolvedValue(undefined),
+    fetchQuota: vi.fn().mockResolvedValue(undefined), fetchTagCounts: vi.fn().mockResolvedValue(undefined),
+    refreshScheduledMetadata: vi.fn().mockResolvedValue(undefined),
+  } as never);
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+const press = async (key: string) => {
+  await act(async () => { fireEvent.keyDown(window, { key, code: `Key${key.toUpperCase()}` }); });
+  await waitFor(() => expect(useEmailStore.getState().isLoadingEmail).toBe(false));
+};
+const openId = () => useEmailStore.getState().selectedEmail?.id;
+
+describe('the default interface reading a thread in its reading pane', () => {
+  it('loads the conversation of a thread row, and not of a lone message', async () => {
+    render(<MailApp />);
+    await waitFor(() => expect(client.getThread).toHaveBeenCalledWith('a', undefined));
+    vi.mocked(client.getThread as ReturnType<typeof vi.fn>).mockClear();
+    await press('j');
+    expect(openId()).toBe('b');
+    expect(client.getThread).not.toHaveBeenCalled();
+  });
+
+  it('steps over rows, opening a thread at its latest message', async () => {
+    render(<MailApp />);
+    const opened: (string | undefined)[] = [];
+    for (const key of ['j', 'j', 'k', 'k']) {
+      await press(key);
+      opened.push(openId());
+    }
+    expect(opened).toEqual(['b', 'c', 'b', 'a2']);
+  });
+
+  it('steps over messages in the focus layout, which has no reading pane', async () => {
+    useSettingsStore.setState({ mailLayout: 'focus' });
+    render(<MailApp />);
+    await press('j');
+    await press('j');
+    expect(openId()).toBe('a1');
+  });
+});
