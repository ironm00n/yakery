+"use client";
+
+import { useEffectiveMailLayout } from "@/hooks/use-effective-mail-layout";
+import { useIsEmbedded } from "@/hooks/use-is-embedded";
+import { useSettingsStore } from "@/stores/settings-store";
+import { useUIStore } from "@/stores/ui-store";
+
+/**
+ * Whether the default interface's reading pane shows a thread as one
+ * conversation: on the desktop, in the layouts that keep the list beside or
+ * above the reader. A thread is then one row in the list, and the reader holds
+ * every message of it, oldest first, the way Mountain View reads one. Focus
+ * keeps its own flow, and phones, tablets and Pro panes keep theirs.
+ *
+ * Reads the device type from the UI store, which useDeviceDetection keeps in
+ * step with the viewport outside Pro panes, so list rows can call it cheaply.
+ */
+export function useConversationInReader(): boolean {
+  const interfaceLayout = useSettingsStore((state) => state.interfaceLayout);
+  const mailLayout = useEffectiveMailLayout();
+  const isMobile = useUIStore((state) => state.isMobile);
+  const isTablet = useUIStore((state) => state.isTablet);
+  const isEmbedded = useIsEmbedded();
+  return interfaceLayout !== 'mountain-view' && mailLayout !== 'focus' && !isMobile && !isTablet && !isEmbedded;
+}
