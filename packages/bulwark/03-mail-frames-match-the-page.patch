diff --git a/lib/email-frame-look.ts b/lib/email-frame-look.ts
new file mode 100644
index 0000000..5223c86
--- /dev/null
+++ b/lib/email-frame-look.ts
@@ -0,0 +1,43 @@
+/**
+ * A mail frame is a document of its own and inherits nothing from the page.
+ * {@link adoptFrameLook} carries the reader's font and text colour into it, and
+ * the background the frame sits on, so an HTML mail reads like a plain-text one
+ * beside it.
+ */
+
+export const FRAME_SURFACE = '--bulwark-frame-surface';
+export const FRAME_TEXT = '--bulwark-frame-text';
+const FRAME_FONT = '--bulwark-frame-font';
+
+/** The frame body's font: the reader's once {@link adoptFrameLook} ran. */
+export const EMAIL_FRAME_FONT_FAMILY = `var(${FRAME_FONT}, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif)`;
+
+/**
+ * Call once the frame's document has parsed and before applyEmailDarkMode,
+ * which reads its canvas from the frame.
+ */
+export function adoptFrameLook(frame: HTMLIFrameElement): void {
+  const root = frame.contentDocument?.documentElement;
+  if (!root) return;
+  const style = getComputedStyle(frame);
+  root.style.setProperty(FRAME_FONT, style.fontFamily);
+  const text = srgb(style.color);
+  if (text) root.style.setProperty(FRAME_TEXT, text.css);
+  for (let el = frame.parentElement; el; el = el.parentElement) {
+    const background = srgb(getComputedStyle(el).backgroundColor);
+    if (background?.opaque) {
+      root.style.setProperty(FRAME_SURFACE, background.css);
+      return;
+    }
+  }
+}
+
+/** Any CSS colour in the rgb()/rgba() form, the only one the dark-mode pass parses. */
+function srgb(color: string): { css: string; opaque: boolean } | null {
+  const ctx = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
+  if (!ctx) return null;
+  ctx.fillStyle = color;
+  ctx.fillRect(0, 0, 1, 1);
+  const [r, g, b, a] = ctx.getImageData(0, 0, 1, 1).data;
+  return { css: a === 255 ? `rgb(${r}, ${g}, ${b})` : `rgba(${r}, ${g}, ${b}, ${+(a / 255).toFixed(3)})`, opaque: a === 255 };
+}
