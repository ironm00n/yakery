index b19c76b..ed648ed 100644
--- a/crates/common/src/auth/mod.rs
+++ b/crates/common/src/auth/mod.rs
@@ -170,7 +170,62 @@ pub(crate) struct AccessTo {
 pub struct AccountInfo {
     pub account_id: u32,
     pub account: Arc<AccountCache>,
-    pub addresses: Vec<String>,
+    pub addresses: AccountAddresses,
+}
+
+/// An account's addresses, and those of them on domains whose sub-addressing folds
+/// `local+tag@domain` into `local@domain` with the default delimiter, as delivery does.
+#[derive(Debug, Default, Clone)]
+pub struct AccountAddresses {
+    pub all: Vec<String>,
+    pub subaddressed: Vec<String>,
+}
+
+impl AccountAddresses {
+    /// Whether `email` is one of the addresses, or a subaddress that delivery folds into one.
+    pub fn owns(&self, email: &str) -> bool {
+        self.all.iter().any(|address| address == email) || self.folded(email).is_some()
+    }
+
+    /// The address `email` folds into, when it is a subaddress of one of them.
+    pub fn folded(&self, email: &str) -> Option<&str> {
+        let (local, domain) = email.split_once('@')?;
+        let (base, _) = local.split_once('+')?;
+        self.subaddressed
+            .iter()
+            .find(|address| address.split_once('@') == Some((base, domain)))
+            .map(String::as_str)
+    }
+}
+
+impl AccountAddresses {
+    pub(crate) fn push(&mut self, address: String, domain: &DomainCache) {
+        if domain.flags & DOMAIN_FLAG_SUB_ADDRESSING != 0 && domain.sub_addressing_custom.is_none() {
+            self.subaddressed.push(address.clone());
+        }
+        self.all.push(address);
+    }
+
+    pub(crate) fn merge(&mut self, other: AccountAddresses) {
+        for address in other.all {
+            if !self.all.contains(&address) {
+                self.all.push(address);
+            }
+        }
+        for address in other.subaddressed {
+            if !self.subaddressed.contains(&address) {
+                self.subaddressed.push(address);
+            }
+        }
+    }
+}
+
+impl std::ops::Deref for AccountAddresses {
+    type Target = [String];
+
+    fn deref(&self) -> &[String] {
+        &self.all
+    }
 }
 
 #[derive(Clone, Copy)]
