@@ -212,6 +217,22 @@ impl Session {
         mismatches
     }
 
+    /// Moves the advertised URLs onto the origin of `connect_url`, keeping their paths
+    /// and templates. `None` when `connect_url` has no scheme, host and port.
+    pub fn with_origin_of(mut self, connect_url: &str) -> Option<Session> {
+        let origin = origin_of(connect_url)?;
+        for url in [
+            &mut self.api_url,
+            &mut self.upload_url,
+            &mut self.download_url,
+        ] {
+            if let Some(rest) = after_authority(url) {
+                *url = format!("{origin}{rest}");
+            }
+        }
+        Some(self)
+    }
+
